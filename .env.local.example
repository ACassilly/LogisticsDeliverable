# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/portlandia_logistics

# JWT
JWT_SECRET=change-me-in-production-use-32-char-min
JWT_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Odoo (CRM + Sales)
ODOO_URL=https://id.portlandialogistics.com
ODOO_DB=portlandia_logistics
ODOO_USERNAME=
ODOO_API_KEY=
ODOO_COMPANY_NAME=Portlandia Logistics LLC

# Email (Microsoft Graph sendMail)
GRAPH_MAIL_TENANT_ID=
GRAPH_MAIL_CLIENT_ID=
GRAPH_MAIL_CLIENT_SECRET=
GRAPH_MAIL_SENDER=connect@portlandialogistics.com

# GTZShip (GlobalTranz API)
GTZSHIP_API_URL=https://dev.gtzintegrate.com/rate/ltl/partner
GTZSHIP_ACCESS_KEY=
GTZSHIP_USERNAME=
GTZSHIP_PASSWORD=
GTZSHIP_CUSTOMER_ID=316977

# Carrier Provider Selection
# Which carrier API to use for rate quoting.
# Options: gtz (default), wwex
CARRIER_PROVIDER=gtz

# Booking Gate
# Set to true ONLY when the full carrier booking pipeline
# (carrier shipment booking, BOL generation) is wired.
# When false, /api/quote/checkout returns 503 BOOKING_DISABLED.
CARRIER_BOOKING_ENABLED=false
NEXT_PUBLIC_CARRIER_BOOKING_ENABLED=false

# WWEX (World Wide Express) — OAuth2 + speedship.com API
# Required when CARRIER_PROVIDER=wwex
# WWEX_CLIENT_ID=8yyRRWiOiKiSPyuSmGspHvZWxcW36H8Q
# WWEX_CLIENT_SECRET=
# WWEX_API_URL=https://www.speedship.com/svc/
# WWEX_AUTH_URL=https://auth.wwex.com/oauth/token
# WWEX_AUDIENCE=wwex-apig
# WWEX_CUSTOMER_ID=

# Public
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
