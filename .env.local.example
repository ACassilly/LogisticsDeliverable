# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/portlandia_logistics

# Auth — Riven Auth (Logto) OIDC SSO (DEFECT-08)
# Hand-rolled JWT auth has been replaced by Logto OIDC.
LOGTO_ENDPOINT=https://auth.rivenai.io
LOGTO_CLIENT_ID=
LOGTO_CLIENT_SECRET=
LOGTO_REDIRECT_URI=https://portlandialogistics.com/api/auth/callback
# Comma-separated emails that should be mapped to the ADMIN role on login.
ADMIN_EMAILS=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Billing — Riven billing API (DEFECT-09)
# Direct Stripe SDK has been replaced by the Riven billing API.
RIVEN_BILLING_URL=https://api.rivenai.io/v1

# Mail — Riven Mail (auth-provisioner email endpoint) (DEFECT-10)
# Microsoft Graph + nodemailer/Gmail fallback have been removed.
RIVEN_MAIL_URL=http://riven-platform_riven-auth-provisioner:8420
# Internal auth secret. In production this is read from the Docker secret
# mounted at /run/secrets/riven-auth-provisioner-internal-secret; set this
# env var for local development.
RIVEN_AUTH_PROVISIONER_SECRET=
RIVEN_MAIL_FROM_EMAIL=noreply@portlandialogistics.com
RIVEN_MAIL_FROM_NAME=Portlandia Logistics

# Odoo (CRM + Sales)
ODOO_URL=https://id.portlandialogistics.com
ODOO_DB=portlandia_logistics
ODOO_USERNAME=
ODOO_API_KEY=
ODOO_COMPANY_NAME=Portlandia Logistics LLC

# GTZShip (GlobalTranz API)
GTZSHIP_API_URL=https://dev.gtzintegrate.com/rate/ltl/partner
GTZSHIP_ACCESS_KEY=
GTZSHIP_USERNAME=
GTZSHIP_PASSWORD=
GTZSHIP_CUSTOMER_ID=316977

# Carrier Provider Selection
# Which carrier API to use for rate quoting.
# Options: gtz (default), wwex
CARRIER_PROVIDER=gtz

# Booking Gate
# Set to true ONLY when the full carrier booking pipeline
# (carrier shipment booking, BOL generation) is wired.
# When false, /api/quote/checkout returns 503 BOOKING_DISABLED.
CARRIER_BOOKING_ENABLED=false
NEXT_PUBLIC_CARRIER_BOOKING_ENABLED=false

# WWEX (World Wide Express) — OAuth2 + speedship.com API
# Required when CARRIER_PROVIDER=wwex
# WWEX_CLIENT_ID=8yyRRWiOiKiSPyuSmGspHvZWxcW36H8Q
# WWEX_CLIENT_SECRET=
# WWEX_API_URL=https://www.speedship.com/svc/
# WWEX_AUTH_URL=https://auth.wwex.com/oauth/token
# WWEX_AUDIENCE=wwex-apig
# WWEX_CUSTOMER_ID=

# Public
NEXT_PUBLIC_SITE_URL=https://portlandialogistics.com
